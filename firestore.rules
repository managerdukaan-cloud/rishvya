rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isSeller() { return signedIn() && role() == 'seller'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function notDisabled() { return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false); }
    // when ON (Admin > Settings > Secure orders) customers can no longer write orders directly; only the placeOrder function can
    function serverOrdersOn() { return exists(/databases/$(database)/documents/settings/security) && get(/databases/$(database)/documents/settings/security).data.serverOrders == true; }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'customer';
      allow update: if isAdmin() || (isOwner(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
      match /{sub}/{doc} { allow read, write: if isOwner(uid) || isAdmin(); }
    }

    // Public sees only active products. Seller products start as 'pending' and need admin approval.
    match /products/{id} {
      allow read: if resource.data.status == 'active' || isAdmin()
                  || (isSeller() && resource.data.sellerId == request.auth.uid);
      allow create: if isAdmin()
                    || (isSeller() && request.resource.data.sellerId == request.auth.uid
                        && request.resource.data.status == 'pending');
      allow update: if isAdmin()
                    || (isSeller() && resource.data.sellerId == request.auth.uid
                        && request.resource.data.sellerId == request.auth.uid
                        && request.resource.data.status == 'pending');
      allow delete: if isAdmin() || (isSeller() && resource.data.sellerId == request.auth.uid);
    }

    // newsletter: anyone can subscribe (doc id = lower-case email), only admin can read
    match /subscribers/{id} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() <= 100
                    && id == request.resource.data.email.lower() && request.resource.data.email.matches('.+@.+[.].+');
      allow read, update, delete: if isAdmin();
    }

    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }

    match /orders/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.status in ['pending_payment', 'placed'] && !serverOrdersOn() && notDisabled();
      allow update: if isAdmin()
                    || (signedIn() && resource.data.customerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelReason','updatedAt'])
                        && ((request.resource.data.status == 'cancelled' && resource.data.status in ['pending_payment', 'placed'])
                            || (request.resource.data.status == 'return_requested' && resource.data.status == 'delivered')));
      allow delete: if isAdmin();
    }


    // Return requests: customer creates one per order (doc id = order id), only admin can process it
    match /returns/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.status == 'requested'
                    && id == request.resource.data.orderId;
      allow update, delete: if isAdmin();
    }

    match /reviews/{id} {
      function okReview() {
        return request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
            && request.resource.data.comment is string && request.resource.data.comment.size() <= 600
            && (!('images' in request.resource.data) || (request.resource.data.images is list && request.resource.data.images.size() <= 3));
      }
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && okReview()
                    && request.resource.data.status == 'approved'
                    && id == request.resource.data.productId + '_' + request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid && okReview()
                    && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
